# Keystore Configuration for Release Builds
# Copy this file to keystore.properties and fill in your values
# NEVER commit keystore.properties to version control!

# Absolute path to your keystore file
storeFile=/path/to/your/release-keystore.jks

# Password for the keystore
storePassword=your_store_password

# Alias of the key within the keystore
keyAlias=your_key_alias

# Password for the key
keyPassword=your_key_password
